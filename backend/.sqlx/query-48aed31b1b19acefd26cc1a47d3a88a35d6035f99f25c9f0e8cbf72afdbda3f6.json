{
  "db_name": "PostgreSQL",
  "query": "SELECT id, project_id, title, description, product,\n                  product_source, vendor, observed_at, communication_id,\n                  feedback_status, created_at, updated_at\n           FROM findings\n           WHERE project_id = $1\n           ORDER BY\n                CASE feedback_status\n                    WHEN 'unreported' THEN 0\n                    WHEN 'reported'    THEN 1\n                    ELSE 2\n                END,\n                observed_at DESC",
